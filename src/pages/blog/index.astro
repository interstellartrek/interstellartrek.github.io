---
import BaseHead from '../../components/BaseHead.astro'; // 注意这里的路径变成了 ../../
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#111] text-gray-300 antialiased font-sans">
		<div class="max-w-screen-xl mx-auto px-6 py-12 md:py-20 grid grid-cols-1 md:grid-cols-4 gap-12">
			
            <!-- ================= 左侧边栏 ================= -->
			<aside class="md:col-span-1 space-y-8">
				<div>
                    <div class="w-16 h-16 rounded-full overflow-hidden mb-4 grayscale hover:grayscale-0 transition duration-500">
					    <img src="https://github.com/interstellartrek.png" alt="Avatar" class="w-full h-full object-cover" />
                    </div>
					<h1 class="text-xl font-bold text-white tracking-tight">Zehao Yu</h1>
                    <p class="text-gray-500 text-sm font-mono mt-1">interstellartrek</p>
				</div>
                <nav>
                    <ul class="space-y-2 text-sm text-gray-500 font-medium">
                        <li><a href="/" class="hover:text-white transition">Home</a></li>
                        <li><a href="/about" class="hover:text-white transition">About</a></li>
                        <!-- 高亮 Writing -->
                        <li><a href="/blog" class="text-white">Writing</a></li>
                        <li><a href="/projects" class="hover:text-white transition">Projects</a></li>
                    </ul>
                </nav>
			</aside>

            <!-- ================= 右侧 Blog 列表 ================= -->
			<main class="md:col-span-3">
                <h1 class="text-3xl font-bold text-white mb-8 tracking-tight">Writing</h1>
                
                <div class="space-y-0 border-t border-gray-800">
                    {posts.map((post) => (
                        <a href={`/blog/${post.slug}/`} class="group block py-6 border-b border-gray-800 hover:bg-white/5 transition -mx-6 px-6">
                            <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-2">
                                <h3 class="text-lg font-medium text-gray-200 group-hover:text-white transition">
                                    {post.data.title}
                                </h3>
                                <time class="text-sm font-mono text-gray-600 shrink-0">
                                    {post.data.pubDate.toLocaleDateString('en-us', {
                                        year: 'numeric',
                                        month: 'short',
                                        day: 'numeric',
                                    })}
                                </time>
                            </div>
                        </a>
                    ))}
                </div>
			</main>
		</div>
	</body>
</html>