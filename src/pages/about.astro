---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_TITLE } from '../consts';
---

<SiteLayout title={`About | ${SITE_TITLE}`} active="about">
	<h1 class="mb-8 text-3xl font-bold tracking-tight text-white">About Me</h1>
	<article class="prose prose-invert prose-gray max-w-none">
		<p class="text-lg leading-relaxed text-gray-300">
			Hi, I'm an undergraduate student in pure mathematics at CUHK-Shenzhen.
		</p>
		<p>
			I'm interested in algebra and analysis. In algebra, I'm currently studying algebraic geometry and algebraic topology. In analysis, I'm focusing on real analysis and functional analysis.
		</p>
	</article>
</SiteLayout>
