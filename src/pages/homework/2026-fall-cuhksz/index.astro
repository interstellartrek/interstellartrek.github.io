---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const posts = (await getCollection('homework'))
	.filter((post) => post.slug.startsWith('2026-fall-cuhksz/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout title="2026 Fall CUHKSZ | Homework | Zehao Yu" active="homework">
	<nav class="mb-6 text-sm text-gray-500" aria-label="Breadcrumb">
		<a href="/homework/" class="hover:text-white">Homework</a>
		<span class="mx-2">/</span>
		<span class="text-gray-300">2026 Fall CUHKSZ</span>
	</nav>
	<h1 class="mb-8 text-3xl font-bold tracking-tight text-white">2026 Fall CUHKSZ</h1>
	<div class="border-t border-gray-800">
		{posts.map((post) => (
			<a href={`/homework/${post.slug}/`} class="group -mx-6 block border-b border-gray-800 px-6 py-6 transition hover:bg-white/5">
				<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
					<h2 class="text-lg font-medium text-gray-200 transition group-hover:text-white">{post.data.title}</h2>
					<time class="shrink-0 font-mono text-sm text-gray-600">
						{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
					</time>
				</div>
				<p class="mt-2 text-sm text-gray-500">{post.data.description}</p>
			</a>
		))}
		{posts.length === 0 && <p class="py-6 text-sm text-gray-500">Homework posts for this session will appear here.</p>}
	</div>
</SiteLayout>
