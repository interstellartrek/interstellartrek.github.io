---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { homeworkSections } from '../../data/homeworkSections';
---

<SiteLayout title="Homework | Zehao Yu" active="homework">
	<h1 class="mb-8 text-3xl font-bold tracking-tight text-white">Homework</h1>
	<div class="border-t border-gray-800">
		{homeworkSections.map((section) => (
			<a href={section.href} class="group -mx-6 flex items-center justify-between border-b border-gray-800 px-6 py-6 transition hover:bg-white/5">
				<h2 class="text-lg font-medium text-gray-200 transition group-hover:text-white">{section.title}</h2>
				<span class="text-gray-600 transition group-hover:translate-x-1 group-hover:text-gray-300">→</span>
			</a>
		))}
	</div>
</SiteLayout>
