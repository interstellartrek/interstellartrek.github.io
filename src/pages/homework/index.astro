---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { homeworkSections } from '../../data/homeworkSections';

const otherPosts = (await getCollection('homework'))
	.filter((post) => !post.slug.includes('/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout title="Homework | Zehao Yu" active="homework">
	<h1 class="mb-8 text-3xl font-bold tracking-tight text-white">Homework</h1>
	{homeworkSections.map((section) => (
		<section class="mb-8 rounded-lg border border-gray-800 bg-white/[0.03] p-6">
			<p class="mb-2 font-mono text-xs uppercase tracking-widest text-gray-500">{section.eyebrow}</p>
			<h2 class="text-xl font-semibold text-white">{section.title}</h2>
			<p class="mt-2 text-sm text-gray-400">{section.description}</p>
			<div class="mt-5 flex flex-wrap gap-3">
				<a href={section.href} class="rounded border border-gray-700 px-4 py-2 text-sm text-gray-200 transition hover:border-gray-500 hover:text-white">{section.linkLabel}</a>
			</div>
		</section>
	))}

	<section class="mt-10">
		<h2 class="mb-4 text-lg font-semibold text-gray-300">Other homework posts</h2>
		<div class="border-t border-gray-800">
			{otherPosts.map((post) => (
				<a href={`/homework/${post.slug}/`} class="group -mx-6 block border-b border-gray-800 px-6 py-6 transition hover:bg-white/5">
					<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
						<h3 class="text-lg font-medium text-gray-200 transition group-hover:text-white">{post.data.title}</h3>
						<time class="shrink-0 font-mono text-sm text-gray-600">
							{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
						</time>
					</div>
					<p class="mt-2 text-sm text-gray-500">{post.data.description}</p>
				</a>
			))}
		</div>
	</section>
</SiteLayout>
