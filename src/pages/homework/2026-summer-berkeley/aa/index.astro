---
import SiteLayout from '../../../../layouts/SiteLayout.astro';

const assignments = [1, 3, 5, 6];
---

<SiteLayout title="MATH 113 Abstract Algebra | Homework | Zehao Yu" active="homework">
	<nav class="mb-6 text-sm text-gray-500" aria-label="Breadcrumb">
		<a href="/homework/" class="hover:text-white">Homework</a>
		<span class="mx-2">/</span>
		<a href="/homework/2026-summer-berkeley/" class="hover:text-white">2026 Summer Berkeley</a>
		<span class="mx-2">/</span>
		<span class="text-gray-300">MATH 113</span>
	</nav>
	<p class="mb-2 font-mono text-xs uppercase tracking-widest text-gray-500">aa</p>
	<h1 class="mb-3 text-3xl font-bold tracking-tight text-white">MATH 113 · Abstract Algebra</h1>
	<p class="mb-8 text-gray-400">Homework PDFs</p>
	<div class="border-t border-gray-800">
		{assignments.map((number) => (
			<a href={`/pdfs/2026-summer-berkeley/aa/aa_${number}.pdf`} target="_blank" rel="noreferrer" class="group flex items-center justify-between gap-4 border-b border-gray-800 py-5 text-gray-300 transition hover:text-white">
				<span>Homework {number}</span>
				<span class="font-mono text-sm text-gray-600 group-hover:text-gray-400">PDF ↗</span>
			</a>
		))}
	</div>
</SiteLayout>
