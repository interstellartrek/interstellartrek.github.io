---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import PdfViewer from '../../../../components/PdfViewer.astro';

const assignments = [1, 3, 5, 6];
---

<SiteLayout title="MATH 113 Abstract Algebra | Homework | Zehao Yu" active="homework">
	<nav class="mb-6 text-sm text-gray-500" aria-label="Breadcrumb">
		<a href="/homework/" class="hover:text-white">Homework</a>
		<span class="mx-2">/</span>
		<a href="/homework/2026-summer-berkeley/" class="hover:text-white">2026 Summer Berkeley</a>
		<span class="mx-2">/</span>
		<span class="text-gray-300">MATH 113</span>
	</nav>
	<p class="mb-2 font-mono text-xs uppercase tracking-widest text-gray-500">aa</p>
	<h1 class="mb-3 text-3xl font-bold tracking-tight text-white">MATH 113 · Abstract Algebra</h1>
	<p class="mb-8 text-gray-400">Homework PDFs</p>
	<div class="space-y-4">
		{assignments.map((number) => (
			<details class="group rounded-lg border border-gray-800 p-5 open:bg-white/[0.02]">
				<summary class="cursor-pointer list-none text-gray-200 transition hover:text-white">
					<span class="flex items-center justify-between gap-4">
						<span>Homework {number}</span>
						<span class="font-mono text-xs text-gray-500">PDF · <span class="group-open:hidden">Show</span><span class="hidden group-open:inline">Hide</span></span>
					</span>
				</summary>
				<div class="mt-5">
					<PdfViewer src={`/pdfs/2026-summer-berkeley/aa/aa_${number}.pdf`} title={`MATH 113 Abstract Algebra Homework ${number}`} />
				</div>
			</details>
		))}
	</div>
</SiteLayout>
