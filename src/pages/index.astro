---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latest = (collection) =>
	collection.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const homeworkPosts = latest(await getCollection('homework'));
const notePosts = latest(await getCollection('note'));
const blogPosts = latest(await getCollection('blog'));
const projects = [
	{ name: 'Personal Website', description: 'Built with Astro and Tailwind CSS', year: '2026', url: 'https://github.com/interstellartrek/interstellartrek.github.io' },
	{ name: 'Achievement System', description: 'A personal system for tracking life goals', year: '2025', url: '#' },
	{ name: 'Deep Learning Demo', description: 'Experiments with machine learning', year: '2024', url: '#' },
];
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION} active="home">
	<div class="space-y-16">
		<section class="max-w-2xl">
			<p class="mb-6 text-lg leading-relaxed text-gray-300">
				Hello, I'm a student at the Chinese University of Hong Kong, Shenzhen. I enjoy mathematics and exploring the frontiers of AI.
			</p>
			<p class="leading-relaxed text-gray-400">
				I'm currently focusing on <span class="text-white">mathematical analysis</span> and <span class="text-white">algebraic geometry</span>. This site is my digital garden for sharing what I learn.
			</p>
			<div class="mt-6 flex items-center gap-2 text-sm text-gray-500">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
				</span>
				Open to collaborations
			</div>
		</section>

		<section>
			<h2 class="mb-6 text-sm font-bold uppercase tracking-wider text-gray-200">Selected Projects</h2>
			<div>
				{projects.map((project) => (
					<a href={project.url} class="group -mx-4 block rounded-lg border-t border-gray-800 px-4 py-4 transition hover:bg-white/5">
						<div class="flex items-baseline justify-between">
							<h3 class="font-medium text-gray-200 transition group-hover:text-white">{project.name}</h3>
							<span class="font-mono text-sm text-gray-600">{project.year}</span>
						</div>
						<p class="mt-1 text-sm text-gray-500">{project.description}</p>
					</a>
				))}
			</div>
		</section>

		<section>
			<div class="mb-6 flex items-center justify-between">
				<h2 class="text-sm font-bold uppercase tracking-wider text-gray-200">Homework</h2>
				<a href="/homework/" class="text-sm text-gray-500 hover:text-white">All homework →</a>
			</div>
			<div class="border-t border-gray-800">
				{homeworkPosts.map((post) => (
					<a href={`/homework/${post.slug}/`} class="flex justify-between gap-4 border-b border-gray-800 py-3 text-gray-400 transition hover:text-white">
						<span>{post.data.title}</span><time class="shrink-0 text-sm text-gray-600">{post.data.pubDate.toLocaleDateString()}</time>
					</a>
				))}
			</div>
		</section>

		<section>
			<div class="mb-6 flex items-center justify-between">
				<h2 class="text-sm font-bold uppercase tracking-wider text-gray-200">Note</h2>
				<a href="/note/" class="text-sm text-gray-500 hover:text-white">All notes →</a>
			</div>
			<div class="border-t border-gray-800">
				{notePosts.map((post) => (
					<a href={`/note/${post.slug}/`} class="flex justify-between gap-4 border-b border-gray-800 py-3 text-gray-400 transition hover:text-white">
						<span>{post.data.title}</span><time class="shrink-0 text-sm text-gray-600">{post.data.pubDate.toLocaleDateString()}</time>
					</a>
				))}
			</div>
		</section>

		<section>
			<div class="mb-6 flex items-center justify-between">
				<h2 class="text-sm font-bold uppercase tracking-wider text-gray-200">Blog</h2>
				<a href="/blog/" class="text-sm text-gray-500 hover:text-white">All posts →</a>
			</div>
			<div class="border-t border-gray-800">
				{blogPosts.map((post) => (
					<a href={`/blog/${post.slug}/`} class="flex justify-between gap-4 border-b border-gray-800 py-3 text-gray-400 transition hover:text-white">
						<span>{post.data.title}</span><time class="shrink-0 text-sm text-gray-600">{post.data.pubDate.toLocaleDateString()}</time>
					</a>
				))}
			</div>
		</section>
	</div>
</SiteLayout>
