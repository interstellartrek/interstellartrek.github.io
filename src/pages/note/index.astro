---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = (await getCollection('note')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout title="Note | Zehao Yu" active="note">
	<h1 class="mb-8 text-3xl font-bold tracking-tight text-white">Note</h1>
	<div class="border-t border-gray-800">
		{posts.map((post) => (
			<a href={`/note/${post.slug}/`} class="group -mx-6 block border-b border-gray-800 px-6 py-6 transition hover:bg-white/5">
				<div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
					<h2 class="text-lg font-medium text-gray-200 transition group-hover:text-white">{post.data.title}</h2>
					<time class="shrink-0 font-mono text-sm text-gray-600">
						{post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
					</time>
				</div>
				<p class="mt-2 text-sm text-gray-500">{post.data.description}</p>
			</a>
		))}
	</div>
</SiteLayout>
