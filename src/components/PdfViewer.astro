---
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<div>
	<iframe
		src={src}
		title={title}
		loading="lazy"
		style="width: 100%; height: 80vh; min-height: 600px; border: 1px solid #374151; border-radius: 0.5rem;"
	></iframe>
	<p class="mt-3 text-sm text-gray-500">
		<a href={src} target="_blank" rel="noreferrer" class="text-gray-300 underline decoration-gray-700 underline-offset-4 hover:text-white">
			Open or download the PDF
		</a>
	</p>
</div>
