---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';

type Section = 'blog' | 'homework' | 'note';
type Props = CollectionEntry<'blog'>['data'] & { section?: Section };

const { title, description, pubDate, updatedDate, heroImage, section = 'blog' } = Astro.props;
---

<SiteLayout title={`${title} | Zehao Yu`} description={description} active={section}>
	<article>
		{heroImage && <img width={1020} height={510} src={heroImage} alt="" class="mb-8 rounded-lg bg-gray-800" />}
		<header class="mb-8 border-b border-gray-800 pb-8">
			<h1 class="mb-4 text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">{title}</h1>
			<div class="font-mono text-sm text-gray-500">
				<time datetime={pubDate.toISOString()}>
					{pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' })}
				</time>
				{updatedDate && <span class="ml-2 italic">(Updated: {updatedDate.toLocaleDateString()})</span>}
			</div>
		</header>
		<div class="prose prose-invert prose-gray max-w-none hover:prose-a:text-green-400 prose-a:no-underline">
			<slot />
		</div>
	</article>
</SiteLayout>
