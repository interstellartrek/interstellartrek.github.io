---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="bg-[#111] text-gray-300 antialiased font-sans">
		<div class="max-w-screen-xl mx-auto px-6 py-12 md:py-20 grid grid-cols-1 md:grid-cols-4 gap-12">
			
            <!-- ================= 左侧边栏 (保持不变) ================= -->
			<aside class="md:col-span-1 space-y-8 hidden md:block">
				<div>
                    <div class="w-16 h-16 rounded-full overflow-hidden mb-4 grayscale hover:grayscale-0 transition duration-500">
					    <img src="https://github.com/你的GitHub用户名.png" alt="Avatar" class="w-full h-full object-cover" />
                    </div>
					<h1 class="text-xl font-bold text-white tracking-tight">Your Name</h1>
                    <p class="text-gray-400 text-sm font-mono mt-1">@your_nickname</p>
				</div>
                <nav>
                    <ul class="space-y-2 text-sm text-gray-500 font-medium">
                        <li><a href="/" class="hover:text-white transition">Home</a></li>
                        <li><a href="/about" class="hover:text-white transition">About</a></li>
                        <li><a href="/homework">Homework</a></li>
                        <li><a href="/note">Note</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/projects" class="hover:text-white transition">Projects</a></li>
                    </ul>
                </nav>
                <div class="text-sm text-gray-600 pt-8 border-t border-gray-800">
                    <a href="/blog" class="hover:text-white transition">← Back to list</a>
                </div>
			</aside>

            <!-- ================= 右侧文章内容 ================= -->
			<main class="md:col-span-3">
                <article>
                    <!-- 文章头图 (如果有的话) -->
                    {heroImage && <img width={1020} height={510} src={heroImage} alt="" class="rounded-lg mb-8 bg-gray-800" />}
                    
                    <div class="mb-8 border-b border-gray-800 pb-8">
                        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 tracking-tight leading-tight">{title}</h1>
                        <div class="text-gray-500 font-mono text-sm">
                            <time>{pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                            {updatedDate && <span class="italic ml-2">(Updated: {updatedDate.toLocaleDateString()})</span>}
                        </div>
                    </div>

                    <!-- 
                        Markdown 内容区域 
                        prose-invert: 自动把黑字变白字适应深色模式
                        prose-gray: 设置灰度
                        max-w-none: 移除宽度限制填满右侧
                    -->
                    <div class="prose prose-invert prose-gray max-w-none hover:prose-a:text-green-400 prose-a:no-underline">
                        <slot />
                    </div>
                </article>
			</main>
		</div>
	</body>
</html>